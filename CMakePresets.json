{
    "version": 6,
    "buildPresets": [
        {
            "name":              "linux",
            "configurePreset":   "linux",
            "targets":          ["all","install"]
        },
        {
            "name":              "mega2560",
            "configurePreset":   "mega2560",
            "targets":          ["all","install"]
        },
        {
            "name":              "stm32l496g",
            "configurePreset":   "stm32l496g",
            "targets":          ["all","install"]
        }
    ],
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "binaryDir": "${sourceDir}/tmp/${presetName}",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_VERBOSE_MAKEFILE": false,
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_STANDARD"  : "17",
                "CMAKE_CXX_STANDARD": "17"
            }
        },
        {
            "name": "linux",
            "inherits": "common",
            "displayName": "x86_64-linux-gnu",
            "description": "native host",
            "toolchainFile": "${sourceDir}/cmake/x86_64-linux-gnu.cmake",
            "cacheVariables": {
                "HW":"pc", "CPU":"i5", "ARCH":"x86_64", "OS":"linux"
            }
        },
        {
            "name": "avr",
            "hidden": true,
            "inherits": "common",
            "description": "AVR8 target",
            "toolchainFile": "${sourceDir}/cmake/avr.cmake",
            "cacheVariables": {
                "ARCH":"avr", "OS":"bare"
            }
        },
        {
            "name": "mega2560",
            "inherits": "avr",
            "cacheVariables": {
                "HW":"arduino2560", "CPU":"atmega2560"
            }
        },
        {
            "name": "cortexM",
            "hidden": true,
            "inherits": "common",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {"OS":"bare"}
        },
        {
            "name": "cortexM4",
            "hidden": true,
            "inherits": "cortexM",
            "cacheVariables": {
                "ARCH":"cortexM4",
                "MCPU":"-mcpu=cortex-m4",
                "MFPU":"-mfpu=fpv4-sp-d16 -mfloat-abi=hard"
            }
        },
        {
            "name": "stm32l496g",
            "hidden": true,
            "inherits": "cortexM",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "HW":"stm32l496g",
                "CPU":"STM32L496AGI"
            }
        }
    ]
}
